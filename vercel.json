{
  "rewrites": [
    { "source": "/", "destination": "/leomodzdevfreeytdownload" },
    { "source": "/leomodzdevfreeytdownload", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/download", "destination": "/api/index.py" },
    { "source": "/async-download", "destination": "/api/index.py" },
    { "source": "/status", "destination": "/api/index.py" },
    { "source": "/download-file", "destination": "/api/index.py" },
    { "source": "/files", "destination": "/api/index.py" },
    { "source": "/cleanup", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "installCommand": "pip install -r requirements.txt && python setup_ffmpeg.py"
}
